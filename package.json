{
  "$schema": "./package.schema.json",
  "license": "MIT",
  "name": "jive-abstract-library",
  "version": "0.1.1",
  "type": "module",
  "peerDependencies": {
    "effect": "^4.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@effect/platform-bun": "^4.0.0",
    "@types/bun": "^1.3.14",
    "@types/ejs": "^3.1.5",
    "commander": "^13.1.0",
    "effect": "^4.0.0",
    "effective-modules": "0.3.1-effect4",
    "ejs": "^6.0.1",
    "jsonc-parser": "^3.3.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "jive:cicd:get-config": "bun src/entrypoints/jive-library.ts cicd get-config",
    "jive:cicd:build": "bun src/entrypoints/jive-library.ts cicd build",
    "jive:cicd:audit": "jive-library cicd audit",
    "jive:cicd:deploy:url": "jive-library cicd deploy-url",
    "jive:cicd:upload-artifacts": "jive-library cicd upload-artifacts",
    "jive:cicd:deploy": "bun src/entrypoints/jive-library.ts cicd deploy",
    "dev": "bun src/entrypoints/jive-library.ts dev"
  },
  "jive": {
    "cicd": {
      "deploy": {
        "verb": "Publish Tag",
        "branches": {
          "main": [
            "latest"
          ]
        },
        "previews": false,
        "sequentially": true
      },
      "runsOnPullRequests": true,
      "runsOn": "ubuntu-latest",
      "requiredSecrets": [
        "NPM_TOKEN"
      ]
    },
    "library": {
      "daemons": []
    }
  }
}
