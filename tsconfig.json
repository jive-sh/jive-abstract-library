// The tsconfig every package built with jive-abstract-library extends, this one included:
// { "extends": "jive-abstract-library/tsconfig.json" }. ${configDir} is the extending package's own folder.
{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    // `jive load` and `jive init` link a workspace package's node_modules entry to its checkout; resolving its imports
    // from the link keeps one copy of a shared peer such as effect.
    "preserveSymlinks": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false
  },
  "include": ["${configDir}/src/**/*.ts"],
  "exclude": ["${configDir}/dist", "${configDir}/node_modules"]
}
